#!/bin/bash
# claude-thread — session picker + tracker for Zed Terminal Threads.
# Set as Zed's agent.terminal_init_command; runs in every new/recreated
# terminal thread. Claude's own ~/.claude/projects store is the source of
# truth for sessions; ~/.claude-thread/ holds everything this wrapper owns:
# state.json (status running/ended, pid, last_used — enables auto-resume in
# recreated threads) and archived/ (session files hidden from claude).
#
# Profiles: extra Claude subscriptions on the same setup. A profile is a
# CLAUDE_CONFIG_DIR at ~/.claude-profiles/<name> that owns only its login and
# per-process state; CLAUDE.md, settings, skills, memory and projects/ are
# symlinks to ~/.claude (the layout Maestro documents for multi-account Claude
# Code). ~/.claude-profiles/map routes folders to profiles. A new session takes
# the profile its folder maps to; a resumed one keeps the profile it started on.
#   cld main …                      force the main account
#   cld profile new|login|map|unmap|list
#   cld ask "<question>"            read-only answer from the main account
#   cld quota [--pick] [--no-probe] each account's usage; --pick = account to use

set -u

CLAUDE_BIN="${CLAUDE_BIN:-claude}"
# default flags for every claude launch (same convention as old ~/cld.sh)
# --chrome dropped: the Chrome extension only pairs in interactive sessions, so
# routines built on it break under `claude -p`. Browser work goes through
# `chrome-wrapper-<identity>` + `agent-browser --cdp` instead, same in both modes.
# bypass for cld/claude-thread sessions only (Shyam's call, 2026-10-02); plain
# `claude` stays on auto via settings.json defaultMode.
# Always applied, on every launch path including sc/arg passthrough — never
# replaced by CLAUDE_THREAD_ARGS, which only appends extra flags.
CLAUDE_FIXED_ARGS=(--dangerously-skip-permissions)
# Remote Control is for the main account only (Shyam's call, 2026-10-27):
# client-profile sessions stay off the phone/desktop app.
CLAUDE_MAIN_ARGS=(--remote-control)
CLAUDE_THREAD_ARGS="${CLAUDE_THREAD_ARGS:-}"

PROFILES_ROOT="${CLAUDE_PROFILES_ROOT:-$HOME/.claude-profiles}"
PROFILE_MAP="$PROFILES_ROOT/map"
# Shared with the main account: what you author, plus history keyed by session
# id (safe for several processes). Allowlist, not denylist: a per-process folder
# a future Claude Code adds must not get shared by accident. sessions/ is the
# local peer registry (one file per pid, no account data): sharing it lets
# agents on different accounts list and message each other over local sockets
# (tested 2026-10-27). Never shared: .claude.json (login, account), daemon/
# jobs/ teams/ (background-agent manager, stays per account), history.jsonl,
# caches, credentials.
PROFILE_SHARED=(CLAUDE.md settings.json keybindings.json skills agents commands
                plugins projects agent-memory memory file-history tasks todos plans taste
                sessions)

# claude_cmd <profile> <args…> — every launch path comes through here. An empty
# profile is the main account.
claude_cmd() {
  local prof="$1"; shift
  if [ -z "$prof" ]; then
    # -u: a profile session's own shell carries CLAUDE_CONFIG_DIR, and `cld main`
    # run from it must still land on ~/.claude
    # shellcheck disable=SC2086 — CLAUDE_THREAD_ARGS is intentionally word-split
    env -u CLAUDE_CONFIG_DIR "$CLAUDE_BIN" "${CLAUDE_FIXED_ARGS[@]}" "${CLAUDE_MAIN_ARGS[@]}" \
      $CLAUDE_THREAD_ARGS "$@"
    return
  fi
  local dir="$PROFILES_ROOT/$prof" mcp rc
  [ -d "$dir" ] || { echo "cld: no profile '$prof' (cld profile new $prof)"; return 1; }
  profile_logged_in "$dir" || {
    echo "cld: profile '$prof' is logged out — run: cld profile login $prof"; return 3; }
  profile_link "$dir"
  # one MCP file per launch: it holds this folder's servers, and parallel tabs
  # on one profile in different folders must not overwrite each other's
  mcp=$(mktemp "$dir/launch-mcp.XXXXXX") || return 1
  profile_compose "$dir" "$(pwd -P)" "$mcp" || { rm -f "$mcp"; return 1; }
  # shellcheck disable=SC2086
  CLAUDE_CONFIG_DIR="$dir" "$CLAUDE_BIN" "${CLAUDE_FIXED_ARGS[@]}" \
    --settings "$dir/launch-settings.json" --mcp-config "$mcp" \
    --append-system-prompt "This session runs on Claude profile '$prof', not Shyam's main account. Remote Control, claude.ai artifacts and claude.ai connectors (Gmail, Calendar, Claude Docs, Vercel) belong to the main account. For read-only help from it, run: claude-thread ask \"<question>\"" \
    $CLAUDE_THREAD_ARGS "$@"
  rc=$?
  rm -f "$mcp"
  return $rc
}

# Link whatever is shared and not there yet. Run on every launch, not only at
# `profile new`: an item ~/.claude creates later (plans/, agent-memory/) would
# otherwise become a separate real folder in the profile and drift.
profile_link() { # <dir>
  local item
  for item in "${PROFILE_SHARED[@]}"; do
    [ -e "$HOME/.claude/$item" ] && [ ! -e "$1/$item" ] && [ ! -L "$1/$item" ] \
      && ln -s "$HOME/.claude/$item" "$1/$item"
  done
  return 0
}

# The profile a launch uses, or nothing for main: an explicit CLAUDE_PROFILE
# (`cld main` sets it) wins; then the profile a resumed session started on, so
# a remap or a `cld main` session never silently moves account; a session that
# already has a transcript but no record predates profiles (or came from plain
# `claude`), so it ran on main; only a brand-new session takes the folder's
# route. Asked per launch because the project menu can cd elsewhere.
resolve_profile() { # [uuid]
  local p="${CLAUDE_PROFILE:-}"
  [ -z "$p" ] && [ -n "${1:-}" ] && p=$(state profile "$1")
  [ -z "$p" ] && [ -n "${1:-}" ] && [ -e "$PROJ_DIR/$1.jsonl" ] && p=main
  [ -z "$p" ] && p=$(profile_which "$(pwd)")
  [ "$p" = main ] && p=""
  echo "$p"
}

# Longest matching route wins (~/www/worktrees/acme-* beats ~/www/worktrees/*).
# A route matches its folder and anything below it, never a sibling sharing
# the prefix (~/www/acme vs ~/www/acme2).
profile_which() { # <dir>
  local dir best="" bestlen=0 route name
  [ -f "$PROFILE_MAP" ] || return 0
  dir=$(cd "$1" 2>/dev/null && pwd -P) || return 0
  while IFS=$'\t' read -r route name; do
    [ -n "$route" ] && [ -n "$name" ] || continue
    # unquoted $route on purpose: glob routes must match as patterns
    # shellcheck disable=SC2254
    case "$dir/" in
      $route/*)
        if [ ${#route} -gt $bestlen ] && [ -d "$PROFILES_ROOT/$name" ]; then
          best="$name"; bestlen=${#route}
        fi ;;
    esac
  done < "$PROFILE_MAP"
  [ -n "$best" ] && echo "$best"
  return 0
}

profile_logged_in() { # <dir>
  CLAUDE_CONFIG_DIR="$1" "$CLAUDE_BIN" auth status 2>/dev/null \
    | python3 -I -c 'import json,sys
try: sys.exit(0 if json.load(sys.stdin).get("loggedIn") else 1)
except Exception: sys.exit(1)'
}

# The two files a profile launch passes in. launch-settings.json turns Remote
# Control off: the shared settings.json turns it on at startup and --settings
# beats user settings. The MCP file = main's user MCP servers plus main's
# servers for this folder, so main stays the one list.
profile_compose() { # <dir> <cwd> <mcp-file>
  python3 -I - "$1" "$2" "$HOME/.claude.json" "$3" <<'PY'
import json, os, sys
d, cwd, main_json, mcp_file = sys.argv[1:5]

def atomic(path, obj):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as fh:
        json.dump(obj, fh, indent=2)
    os.replace(tmp, path)   # parallel launches never see a half-written file

atomic(os.path.join(d, "launch-settings.json"), {"remoteControlAtStartup": False})
servers = {}
try:
    m = json.load(open(main_json))
    servers.update(m.get("mcpServers", {}))
    servers.update(m.get("projects", {}).get(cwd, {}).get("mcpServers", {}))
except Exception:
    pass
atomic(mcp_file, {"mcpServers": servers})
PY
}

profile_cmd() { # new|login|map|unmap|list …
  local sub="${1:-}" name="${2:-}" dir route item d
  case "$sub" in new|login|map)
    case "$name" in
      main) echo "cld: 'main' is the default account, not a profile"; return 1 ;;
      ""|-*|*[!a-z0-9-]*) echo "cld: profile name: lowercase letters, digits, hyphens"; return 1 ;;
    esac ;;
  esac
  dir="$PROFILES_ROOT/$name"
  case "$sub" in
    new)
      [ -e "$dir" ] && { echo "cld: profile '$name' already exists"; return 1; }
      mkdir -p "$dir"
      profile_link "$dir"
      echo "created $dir"
      echo "next: cld profile login $name    then: cld profile map $name <folder-or-glob>" ;;
    login)
      [ -d "$dir" ] || { echo "cld: no profile '$name'"; return 1; }
      echo "In the browser, sign in with the account meant for '$name' —"
      echo "if it shows your main account, switch accounts first."
      CLAUDE_CONFIG_DIR="$dir" "$CLAUDE_BIN" auth login ;;
    map)
      [ -d "$dir" ] || { echo "cld: no profile '$name'"; return 1; }
      [ -n "${3:-}" ] || { echo "usage: cld profile map <name> <folder-or-glob>"; return 1; }
      route="${3/#\~/$HOME}"
      case "$route" in
        *[\*\?\[]*) ;;   # glob: stored as written
        *) route=$(cd "$route" 2>/dev/null && pwd -P) || { echo "cld: no such folder: $3"; return 1; } ;;
      esac
      mkdir -p "$PROFILES_ROOT"; touch "$PROFILE_MAP"
      awk -F'\t' -v r="$route" '$1 != r' "$PROFILE_MAP" > "$PROFILE_MAP.tmp"
      printf '%s\t%s\n' "$route" "$name" >> "$PROFILE_MAP.tmp"
      mv "$PROFILE_MAP.tmp" "$PROFILE_MAP"
      echo "$route → $name" ;;
    unmap)
      [ -n "$name" ] || { echo "usage: cld profile unmap <folder-or-glob>"; return 1; }
      route="${name/#\~/$HOME}"
      case "$route" in *[\*\?\[]*) ;; *) route=$(cd "$route" 2>/dev/null && pwd -P || echo "$route") ;; esac
      [ -f "$PROFILE_MAP" ] && awk -F'\t' -v r="$route" '$1 != r' "$PROFILE_MAP" > "$PROFILE_MAP.tmp" \
        && mv "$PROFILE_MAP.tmp" "$PROFILE_MAP"
      echo "unmapped $route" ;;
    list)
      echo "main  ~/.claude  — default, Remote Control on"
      for d in "$PROFILES_ROOT"/*/; do
        [ -d "$d" ] || continue
        if profile_logged_in "${d%/}"; then item="logged in"; else item="NOT logged in"; fi
        echo "$(basename "$d")  ${d%/}  — $item"
      done
      [ -s "$PROFILE_MAP" ] && { echo; echo "routes:"; awk -F'\t' '{printf "  %s → %s\n", $1, $2}' "$PROFILE_MAP"; }
      echo
      echo "reminder: turn off 'Help improve Claude' in each profile's account"
      echo "          (claude.ai → Settings → Privacy); no CLI can check it" ;;
    *) echo "usage: cld profile new|login|map|unmap|list"; return 1 ;;
  esac
}

# Read-only help from the main account for a profile session: plan mode can
# look things up and answer, never send, publish or change anything as main.
ask_main() {
  [ -n "${1:-}" ] || { echo 'usage: cld ask "<question>"'; return 1; }
  env -u CLAUDE_CONFIG_DIR -u CLAUDE_PROFILE "$CLAUDE_BIN" -p --permission-mode plan "$*"
}

# `cld quota [--pick]` — each account's claude.ai usage, so agents can send heavy
# work to a profile with headroom and save main's quota (Shyam's call,
# 2026-11-01). No CLI reports usage; the statusline (bin/statusline.sh) caches
# the rate_limits it is handed into <config dir>/usage.json, so a reading is only
# as fresh as that account's last interactive reply. Only the 7-day window
# counts: the 5-hour limit is gone (Shyam, 2026-11-01). A window whose resets_at
# has passed counts as 0%. --pick prints just the account to use: the
# logged-in profile with the most headroom, else main, else "none".
# A logged-in account with no reading gets probed: one Haiku message, no tools,
# `-p --output-format stream-json`, whose rate_limit_event carries the 7-day
# utilization (~$0.01; a rejected one at the limit costs $0). Transcripts never
# record rate limits, so this and the statusline are the only sources
# (checked 2026-11-01). --no-probe skips it.
QUOTA_LIMIT="${CLAUDE_QUOTA_LIMIT:-90}"   # 7-day % that counts as full
quota_cmd() {
  local rows="" d name pick="" probe=1 a
  for a in "$@"; do
    case "$a" in --pick) pick=--pick ;; --no-probe) probe=0 ;;
      *) echo "usage: cld quota [--pick] [--no-probe]"; return 1 ;; esac
  done
  rows="main	$HOME/.claude	1"$'\n'
  for d in "$PROFILES_ROOT"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    if profile_logged_in "${d%/}"; then rows+="$name	${d%/}	1"$'\n'
    else rows+="$name	${d%/}	0"$'\n'; fi
  done
  # rows go in as an argument: stdin is the heredoc
  python3 -I - "$pick" "$QUOTA_LIMIT" "$rows" "$probe" "$CLAUDE_BIN" <<'PY'
import json, os, subprocess, sys, tempfile, time
pick, limit = sys.argv[1] == "--pick", float(sys.argv[2])
do_probe, claude_bin = sys.argv[4] == "1", sys.argv[5]
now = time.time()

def probe(name, d):
    """One-message run on that account; cache its 7-day window like the statusline does."""
    env = dict(os.environ)
    env.pop("CLAUDE_CONFIG_DIR", None)
    if name != "main":
        env["CLAUDE_CONFIG_DIR"] = d
    try:
        with tempfile.TemporaryDirectory() as cwd:   # no project CLAUDE.md, no repo
            out = subprocess.run(
                [claude_bin, "-p", "--model", "haiku", "--tools", "",
                 "--output-format", "stream-json", "--verbose", "Reply with: ok"],
                cwd=cwd, env=env, capture_output=True, text=True, timeout=120).stdout
    except Exception:
        return
    for line in out.splitlines():
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        sd = ((ev.get("rate_limit_info") or {}).get("unifiedWindows") or {}).get("seven_day")
        if ev.get("type") == "rate_limit_event" and sd and sd.get("utilization") is not None:
            rec = {"updated_at": int(time.time()),
                   "seven_day": {"used_percentage": round(float(sd["utilization"]) * 100, 1),
                                 "resets_at": sd.get("resetsAt")}}
            tmp = f"{d}/usage.json.{os.getpid()}"
            with open(tmp, "w") as fh:
                json.dump(rec, fh)
            os.replace(tmp, f"{d}/usage.json")
            return

def window(w):
    if not isinstance(w, dict) or w.get("used_percentage") is None:
        return None
    if (w.get("resets_at") or 0) <= now:
        return 0.0          # window rolled over since the reading
    return float(w["used_percentage"])

def ago(t):
    s = max(0, int(now - t))   # a probe can finish after `now` was taken
    return f"{s//60}m ago" if s < 3600 else (f"{s//3600}h ago" if s < 86400 else f"{s//86400}d ago")

accts = []
for line in sys.argv[3].splitlines():
    name, d, logged = line.split("\t")
    if do_probe and logged == "1" and not os.path.exists(f"{d}/usage.json"):
        probe(name, d)
    try:
        u = json.load(open(f"{d}/usage.json"))
    except Exception:
        u = None
    sd = (u or {}).get("seven_day") or {}
    accts.append(dict(name=name, logged=logged == "1",
                      week=window(sd) if u else None, resets=sd.get("resets_at"),
                      seen=ago(u["updated_at"]) if u and u.get("updated_at") else "never"))

def usable(a):
    return a["logged"] and (a["week"] is None or a["week"] < limit)

# known headroom first (lowest %), then profiles with no reading yet
profiles = sorted((a for a in accts if a["name"] != "main" and usable(a)),
                  key=lambda a: (a["week"] is None, a["week"] or 0))
main = next(a for a in accts if a["name"] == "main")
choice = profiles[0]["name"] if profiles else ("main" if usable(main) else "none")

if pick:
    print(choice); sys.exit(0)
fmt = lambda x: "?" if x is None else f"{x:.0f}%"
def reset(t):
    # next reset in local time + countdown; a passed one means the reading is from
    # the previous window and the account is back to 0% (see window())
    if not t:
        return "?"
    if t <= now:
        return "already reset"
    s = int(t - now)
    left = f"{s//86400}d {s%86400//3600}h" if s >= 86400 else f"{s//3600}h {s%3600//60}m"
    return f"{time.strftime('%a %d %b %H:%M', time.localtime(t))} (in {left})"

print(f"{'account':<16}{'7d':>6}  {'resets':<30}reading")
for a in accts:
    note = "" if a["logged"] else "  (logged out)"
    print(f"{a['name']:<16}{fmt(a['week']):>6}  {reset(a['resets']):<30}{a['seen']}{note}")
print(f"→ use: {choice}   (full at {limit:.0f}%; '?' = no reading yet)")
PY
}

profile_email() { # <dir, or "" for main> — the account's email; nothing if logged out
  if [ -z "$1" ]; then env -u CLAUDE_CONFIG_DIR "$CLAUDE_BIN" auth status
  else CLAUDE_CONFIG_DIR="$1" "$CLAUDE_BIN" auth status; fi 2>/dev/null \
    | python3 -I -c 'import json,sys
try:
    d = json.load(sys.stdin)
    if d.get("loggedIn"): print(d.get("email") or "logged in")
except Exception: pass'
}

# `cld @<name>`: the account whose name starts with <name>; an exact name always
# wins, so `@dev` still works once `dev2` exists. `cld @` alone asks. Prints the
# name ("main" for the main account); the menu goes to stderr because callers
# capture stdout.
profile_pick() { # <prefix>
  local want="$1" names=(main) hits=() d n i ans def email
  for d in "$PROFILES_ROOT"/*/; do [ -d "$d" ] && names+=("$(basename "$d")"); done
  if [ -n "$want" ]; then
    for n in "${names[@]}"; do
      [ "$n" = "$want" ] && { echo "$n"; return 0; }
      case "$n" in "$want"*) hits+=("$n") ;; esac
    done
    [ ${#hits[@]} -eq 1 ] && { echo "${hits[0]}"; return 0; }
    if [ ${#hits[@]} -eq 0 ]; then echo "cld: no account matches '@$want' (have: ${names[*]})" >&2
    else echo "cld: '@$want' matches ${hits[*]}, type more of the name" >&2; fi
    return 1
  fi
  def=$(profile_which "$(pwd)"); def="${def:-main}"
  echo "── which account? ($(pwd | sed "s|^$HOME|~|")) ──" >&2
  i=0
  for n in "${names[@]}"; do
    i=$((i+1))
    if [ "$n" = main ]; then email=$(profile_email ""); else email=$(profile_email "$PROFILES_ROOT/$n"); fi
    printf '  %d) %-16s %s%s\n' "$i" "$n" "${email:-NOT logged in}" \
      "$([ "$n" = "$def" ] && echo '   ← this folder')" >&2
  done
  printf '  choose [Enter = %s, q = quit]: ' "$def" >&2
  read -r ans || return 1
  case "$ans" in
    "") echo "$def" ;;
    q) return 1 ;;
    *[!0-9]*) echo "cld: pick a number" >&2; return 1 ;;
    *) { [ "$ans" -ge 1 ] && [ "$ans" -le ${#names[@]} ]; } || { echo "cld: no choice $ans" >&2; return 1; }
       echo "${names[$((ans-1))]}" ;;
  esac
}
# claude encodes the cwd by replacing every non-alphanumeric char with '-'
ENC_CWD="$(pwd | sed 's/[^a-zA-Z0-9]/-/g')"
PROJ_DIR="$HOME/.claude/projects/$ENC_CWD"
ARCHIVE_DIR="$HOME/.claude-thread/archived/$ENC_CWD"

# state <cmd> [args] — all state-file access goes through here (flock'd).
#   prune                    mark running-sessions with dead pids as ended
#   claim <cwd> <projdir> <tid>   the session this Zed thread (tid) held last
#                                 time, else the most recently active one for
#                                 cwd; marks it running, prints its uuid
#   start <uuid> <cwd> <tid> [profile]  upsert session as running under this
#                                 pid, bind it to this Zed thread, record account
#   profile <uuid>           the account a session started on, if recorded
#   profiles                 "<uuid>\t<profile>" for every non-main session
#   end <uuid>               mark session ended
#   bound <tid> <projdir>    print the session this thread holds, if resumable
#   hold <uuid> <tid>        thread is parked on this session without running
#                            claude — keeps other tabs off it
#   running                  print uuids running or held (for menu marks)
state() {
  python3 - "$@" "$$" <<'PY'
import fcntl, json, os, re, subprocess, sys, time
cmd, *args = sys.argv[1:]
pid = int(args[-1]); args = args[:-1]
path = os.path.expanduser("~/.claude-thread/state.json")
os.makedirs(os.path.dirname(path), exist_ok=True)
fh = open(path, "a+")
fcntl.flock(fh, fcntl.LOCK_EX)
fh.seek(0)
try:
    st = json.load(fh)
except Exception:
    st = {}
sess = st.setdefault("sessions", {})

def alive(p):
    try:
        os.kill(p, 0); return True
    except Exception:
        return False

# session UUIDs referenced by ANY live claude process, regardless of who
# launched it (sc passthrough, Zed, manual, a crashed terminal that never
# updated state). This is the source of truth for "is it already open".
def live_uuids():
    try:
        ps = subprocess.run(["ps", "-eo", "command"], capture_output=True,
                            text=True, timeout=3).stdout
    except Exception:
        return set()
    found = set()
    for line in ps.splitlines():
        if "claude" not in line:
            continue
        for m in re.finditer(r"--(?:resume|session-id)\s+([0-9a-f-]{36})", line):
            found.add(m.group(1))
    return found

open_now = live_uuids()

def prune():
    # "held" = a parked wrapper shell owns it; same liveness rule as running,
    # so closing a parked tab releases its session
    for u, s in sess.items():
        if s.get("status") in ("running", "held") and not alive(s.get("pid", 0)) \
           and u not in open_now:
            s["status"] = "ended"
    # bindings for tabs closed long ago are dead weight — Zed never hands that
    # terminal_id out again. Long TTL: a tab you have not touched in months is
    # still a tab, it just falls back to activity ranking once forgotten.
    cutoff = time.time() - 90 * 86400
    for t in [t for t, v in st.get("threads", {}).items()
              if v.get("updated", 0) < cutoff]:
        del st["threads"][t]

prune()
out = ""
threads = st.setdefault("threads", {})

def bind(tid, u, cwd):
    if not tid:
        return
    # one session ↔ one tab: a session can only be where it was most recently
    # opened, so drop any older tab still claiming it (tabs get closed without
    # telling us, and a stale duplicate would have two tabs park on one session)
    for other in [t for t, v in threads.items()
                  if v.get("session") == u and t != tid]:
        del threads[other]
    threads[tid] = {"session": u, "cwd": cwd, "updated": time.time()}

def activity(projdir, u):
    """True last-activity time: claude appends to the jsonl on every turn."""
    try:
        return os.path.getmtime(os.path.join(projdir, u + ".jsonl"))
    except OSError:
        return 0

if cmd == "claim":
    cwd, projdir, tid = args
    cands = [(u, s) for u, s in sess.items()
             if s.get("cwd") == cwd and s.get("status") == "ended"
             and u not in open_now  # never resume a session already open elsewhere
             and os.path.exists(os.path.join(projdir, u + ".jsonl"))]
    if cands:
        # First choice: whatever this very thread was holding before the restart.
        want = threads.get(tid, {}).get("session") if tid else None
        pick = next((c for c in cands if c[0] == want), None)
        # Otherwise the most recently *active* session, ranked by jsonl mtime and
        # not by last_used: a hard Zed quit kills claude before `state end` runs,
        # so last_used stays frozen at session start and the session you were
        # actually working in loses to an idle one that was closed cleanly.
        if pick is None:
            pick = max(cands, key=lambda x: activity(projdir, x[0]))
        u, s = pick
        s.update(status="running", pid=pid, last_used=time.time())
        bind(tid, u, cwd)
        out = u
elif cmd == "start":
    u, cwd, tid, *rest = args
    sess.setdefault(u, {}).update(cwd=cwd, status="running", pid=pid,
                                  last_used=time.time())
    sess[u].setdefault("started", time.time())
    # the account it runs on ("main" or a profile): a resume stays on it, and
    # billing can later tell which subscription did the work
    if rest and rest[0]:
        sess[u]["profile"] = rest[0]
    bind(tid, u, cwd)
elif cmd == "profile":
    out = sess.get(args[0], {}).get("profile", "")
elif cmd == "profiles":
    out = "\n".join(f"{u}\t{s['profile']}" for u, s in sess.items()
                    if s.get("profile") and s["profile"] != "main")
elif cmd == "end":
    u = args[0]
    if u in sess:
        sess[u].update(status="ended", last_used=time.time())
elif cmd == "bound":
    tid, projdir = args
    u = threads.get(tid, {}).get("session") if tid else None
    # prune() already demoted stale holds, so "ended" here means genuinely free
    if u and sess.get(u, {}).get("status") == "ended" and u not in open_now \
       and os.path.exists(os.path.join(projdir, u + ".jsonl")):
        out = u
elif cmd == "hold":
    u, tid = args
    if u in sess:
        sess[u].update(status="held", pid=pid)   # not last_used: parking is not activity
        bind(tid, u, sess[u].get("cwd", ""))
elif cmd == "running":
    # union of state-tracked running/held + any live claude process
    marked = {u for u, s in sess.items() if s.get("status") in ("running", "held")}
    out = "\n".join(marked | open_now)

fh.seek(0); fh.truncate()
json.dump(st, fh, indent=2)
fh.close()
if out:
    print(out)
PY
}

# Which Zed terminal thread are we? Zed hands the spawned shell no identifying
# handle at all — verified 2026-09-22: every thread's environment is byte-identical
# (only ZED_TERM/ZED_ENVIRONMENT/WINDOWID, and WINDOWID is per *window*), and the
# terminal does not answer the CSI 21 t title report. But the title is a write
# channel: Zed persists an OSC-set title into its own sqlite within milliseconds,
# and terminal_id survives a restart. So stamp a nonce into the title, then read
# back which row it landed in. Prints the terminal_id, or nothing if unavailable —
# every caller degrades to plain recency ranking.
zed_terminal_id() {
  [ "${ZED_TERM:-}" = "true" ] || return 0
  # /dev/tty can exist yet be unopenable (no controlling terminal — sourced in a
  # script, piped, under a daemon). Probe it, or the failing redirect below
  # prints "Device not configured" before 2>/dev/null can swallow it.
  ( : > /dev/tty ) 2>/dev/null || return 0
  local db nonce
  db=$(ls -dt "$HOME/Library/Application Support/Zed/db"/*/db.sqlite 2>/dev/null | head -1)
  [ -n "$db" ] || return 0
  nonce="ct-$$-${RANDOM}-$(date +%s)"
  # to /dev/tty, not stdout — stdout is captured by the caller's $( )
  printf '\033]0;%s\007' "$nonce" > /dev/tty 2>/dev/null || return 0
  python3 - "$nonce" "$db" <<'ZTID'
import sqlite3, sys, time
nonce, db = sys.argv[1], sys.argv[2]
deadline = time.time() + 3
while time.time() < deadline:
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=0.5)
        row = con.execute(
            "select terminal_id from sidebar_terminal_threads where title=?",
            (nonce,)).fetchone()
        con.close()
        if row:
            print(row[0])
            break
    except Exception:
        pass   # schema moved, db locked, not a Zed build we know — just give up
    time.sleep(0.05)
ZTID
}

# terminal title = "<worktree-dir>:<branch>" so same-worktree threads share a
# visible prefix in Zed's sidebar and its filter can match them as a group
set_title() { # [profile] — default: what a new session here would use
  local branch name top main title
  branch=$(git branch --show-current 2>/dev/null)
  [ -z "$branch" ] && branch=$(git rev-parse --short HEAD 2>/dev/null || true)
  name=$(basename "$(pwd)")
  top=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$top" ]; then
    name=$(basename "$top")
    main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")
    # Zed nests worktrees as <base>/<wt-name>/<repo-dir> — in that layout the
    # toplevel basename is just the repo name, so use the parent dir instead
    if [ "$top" != "$main" ] && [ "$name" = "$(basename "$main")" ]; then
      name=$(basename "$(dirname "$top")")
    fi
  fi
  title="$name${branch:+:$branch}"
  # a profile tab says so up front — the account it bills is not otherwise
  # visible anywhere
  local prof; if [ $# -gt 0 ]; then prof="$1"; else prof=$(resolve_profile); fi
  [ -n "$prof" ] && title="[$prof] $title"
  printf '\033]0;%s\007' "$title"
}

# run claude in foreground, keep state current around it
run_claude() { # <uuid> <args...>
  local uuid="$1"; shift
  local prof; prof=$(resolve_profile "$uuid")
  state start "$uuid" "$(pwd)" "$TERMINAL_ID" "${prof:-main}" >/dev/null
  set_title "$prof"
  trap ':' INT
  claude_cmd "$prof" "$@"
  trap - INT
  state end "$uuid" >/dev/null
}

# list_sessions <dir> -> lines: "<mtime_epoch>\t<uuid>\t<preview>", newest first.
# One python process for the whole dir; previews cached in
# ~/.claude-thread/preview-cache.json (a preview from a real user message never
# changes → cached as final; skip/fallback entries recheck when the file grows).
list_sessions() {
  local dir="$1"
  [ -d "$dir" ] || return 0
  python3 - "$dir" <<'PY'
import json, os, re, sys

d = sys.argv[1]
cache_path = os.path.expanduser("~/.claude-thread/preview-cache.json")
try:
    cache = json.load(open(cache_path))
except Exception:
    cache = {}

def compute(path):
    """-> (preview, final, skip)"""
    preview, fallback = "", ""
    try:
        with open(path) as fh:
            for i, line in enumerate(fh):
                if i > 300:
                    break
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                # non-interactive sessions (claude -p / SDK runs, e.g. cron jobs)
                if j.get("entrypoint") == "sdk-cli":
                    return "", True, True
                if j.get("type") == "summary" and j.get("summary"):
                    return j["summary"], True, False
                if j.get("type") == "user":
                    c = j.get("message", {}).get("content")
                    if isinstance(c, str): t = c
                    elif isinstance(c, list):
                        t = next((b.get("text","") for b in c if b.get("type")=="text"), "")
                    else: t = ""
                    is_cmd = "<command-name>" in t or "<local-command-stdout>" in t
                    t = re.sub(r"<[^>]+>", " ", t)
                    t = " ".join(t.split())
                    if t.startswith("Caveat: The messages below were generated"):
                        continue
                    if is_cmd:
                        fallback = fallback or t
                        continue
                    if t:
                        return t, True, False
    except Exception:
        pass
    if fallback:
        return fallback, False, False   # command-only so far — may improve later
    return "", False, True              # nothing real yet — hidden, recheck later

out, changed = [], False
for f in os.listdir(d):
    if not f.endswith(".jsonl"):
        continue
    path = os.path.join(d, f)
    uuid = f[:-6]
    try:
        mt = int(os.path.getmtime(path))
    except OSError:
        continue
    c = cache.get(uuid)
    if c is None or not (c.get("final") or c.get("mtime") == mt):
        preview, final, skip = compute(path)
        c = {"mtime": mt, "preview": preview[:60], "final": final, "skip": skip}
        cache[uuid] = c
        changed = True
    if not c["skip"]:
        out.append((mt, uuid, c["preview"]))

if changed:
    try:
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        json.dump(cache, open(cache_path, "w"))
    except Exception:
        pass

for mt, uuid, preview in sorted(out, reverse=True):
    print(f"{mt}\t{uuid}\t{preview}")
PY
}

# countdown before auto-resume: Enter = resume now, n = fresh session, other
# key = menu, timeout = resume. Returns 0 resume, 1 menu, 2 new.
countdown_choice() { # <uuid-short>
  local k
  printf "resuming %s in 10s — Enter=now, n=new, any other key=menu... " "$1"
  if read -t 10 -n 1 -s k; then
    echo
    [ -z "$k" ] && return 0  # Enter arrives as empty (newline is the delimiter)
    case "$k" in n|N) return 2 ;; esac
    return 1
  fi
  echo
  return 0
}

# one session's cached listing line: "<mtime>\t<uuid>\t<preview>"
session_line() { # <uuid>
  list_sessions "$PROJ_DIR" | awk -F'\t' -v u="$1" '$2 == u {print; exit}'
}

# A thread Zed just restored. Its terminal_id already tells us which session it
# holds, so don't spend a claude process finding that out: each one is ~360MB
# resident and idles at ~1% of a core, so restoring 14 tabs eagerly costs ~5GB
# to render 14 conversations you are not looking at. Park on the session instead
# (held, so no other tab claims it) and wait — the tab you type in is the one
# that wanted to be running.
lazy_resume() { # <uuid>
  local u="$1" line mt prev
  line=$(session_line "$u")
  mt=$(printf '%s' "$line" | cut -f1)
  prev=$(printf '%s' "$line" | cut -f3)
  [ -z "$prev" ] && prev="${u:0:8}"
  state hold "$u" "$TERMINAL_ID" >/dev/null
  # sidebar still reads as the conversation; ◦ marks it as not running, and the
  # account it will resume on shows before you press Enter
  local prof; prof=$(resolve_profile "$u")
  [ -n "$prof" ] && prev="[$prof] $prev"
  printf '\033]0;◦ %s\007' "$prev"
  echo
  printf "  \033[2m◦\033[0m %s  \033[2m%s%s\033[0m\n" \
         "$prev" "$(basename "$(pwd)")" "${mt:+ · $(age "$mt")}"
  echo "  Enter=resume  n=new  m=menu  q=shell"
  printf "> "
  read -r ans || { state end "$u" >/dev/null; exit 0; }
  case "$ans" in
    n) state end "$u" >/dev/null; new_session ;;
    m) state end "$u" >/dev/null; main_menu ;;
    q) state end "$u" >/dev/null; set_title; exit 0 ;;
    *) run_claude "$u" --resume "$u"; post_exit_menu ;;
  esac
}

# ── spawned agents ──
# `cld spawn <name> --brief <file>` queues a long-lived agent for this folder;
# the next terminal thread opened here (cmd-n) takes it and starts it. cld can't
# open that tab itself: Zed has no command, link or extension API that starts a
# terminal thread (checked 2026-10-27), and a plain terminal is never restored
# by Zed, so it would not live long. The brief is copied in, so the file can
# change or go away after queueing.
SPAWN_DIR="$HOME/.claude-thread/spawn"

spawn_cmd() { # <name> --brief <file> | --list | --cancel <name>
  local name="${1:-}" prof f
  case "$name" in
    ""|--list)
      ls "$SPAWN_DIR"/*.json >/dev/null 2>&1 || { echo "no agents waiting"; return 0; }
      for f in "$SPAWN_DIR"/*.json; do
        python3 -I -c 'import json,sys,os,time
r = json.load(open(sys.argv[1])); m = int((time.time() - r["queued"]) / 60)
cwd = r["cwd"].replace(os.path.expanduser("~"), "~", 1)
print("  %-20s %-14s %s  (%dm ago)" % (r["name"], r["profile"], cwd, m))' "$f"
      done
      return 0 ;;
    --cancel)
      [ -f "$SPAWN_DIR/${2:-}.json" ] || { echo "cld: no agent '${2:-}' waiting"; return 1; }
      rm "$SPAWN_DIR/$2.json"; echo "cancelled '$2'"; return 0 ;;
    -*|*[!a-z0-9-]*) echo "cld: agent name: lowercase letters, digits, hyphens"; return 1 ;;
  esac
  [ "${2:-}" = --brief ] && [ -n "${3:-}" ] \
    || { echo 'usage: cld [@account] spawn <name> --brief <file>'; return 1; }
  [ -s "$3" ] || { echo "cld: brief file missing or empty: $3"; return 1; }
  [ -e "$SPAWN_DIR/$name.json" ] \
    && { echo "cld: '$name' is already waiting (cld spawn --cancel $name)"; return 1; }
  prof=$(resolve_profile); prof="${prof:-main}"
  mkdir -p "$SPAWN_DIR"
  python3 -I - "$SPAWN_DIR/$name.json" "$(pwd -P)" "$name" "$prof" "$3" <<'PY' || return 1
import json, os, sys, time
out, cwd, name, prof, brief = sys.argv[1:6]
req = {"cwd": cwd, "name": name, "profile": prof,
       "brief": open(brief).read(), "queued": int(time.time())}
with open(out + ".tmp", "w") as fh:
    json.dump(req, fh)
os.replace(out + ".tmp", out)
PY
  echo "queued '$name' on $prof for $(pwd -P | sed "s|^$HOME|~|")"
  echo "next: press cmd-n in this project's Zed window; the new tab starts it"
}

# The oldest request for this folder, moved aside so it is ours: mv is atomic,
# so two tabs opened at once never start the same agent.
spawn_take() {
  local f here; here=$(pwd -P)
  for f in $(ls -tr "$SPAWN_DIR"/*.json 2>/dev/null); do
    [ "$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["cwd"])' "$f" 2>/dev/null)" = "$here" ] \
      || continue
    mv "$f" "$f.$$.taken" 2>/dev/null && { echo "$f.$$.taken"; return 0; }
  done
  return 0
}

spawn_run() { # <taken request>
  local u name prof brief
  u=$(uuidgen | tr 'A-Z' 'a-z')
  name=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["name"])' "$1")
  prof=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["profile"])' "$1")
  brief=$(python3 -I -c 'import json,sys; sys.stdout.write(json.load(open(sys.argv[1]))["brief"])' "$1")
  rm -f "$1"
  echo "starting agent '$name' on $prof"
  CLAUDE_PROFILE="$prof" run_claude "$u" --session-id "$u" -n "$name" "$brief"
  post_exit_menu
}

# fresh session — no listing, no previews. The fast path.
new_session() {
  local u; u=$(uuidgen | tr 'A-Z' 'a-z')
  run_claude "$u" --session-id "$u"
  post_exit_menu
}

age() { # epoch -> "3h" / "2d"
  local s=$(( $(date +%s) - $1 ))
  if   [ $s -lt 3600 ];   then echo "$((s/60))m"
  elif [ $s -lt 86400 ];  then echo "$((s/3600))h"
  else echo "$((s/86400))d"; fi
}

# Every project claude has transcripts for, newest first:
# "<mtime>\t<session count>\t<cwd>". Zed forgets a terminal thread the moment you
# close it — the row survives in its sqlite but nothing in the UI offers it back —
# so this is the only route to a session whose tab is gone and whose folder you
# have no tab open in.
#
# The directory name under ~/.claude/projects is a lossy encoding of the path
# (every non-alphanumeric became '-', so '/a/b-c' and '/a-b/c' collide), which
# makes it unusable as a path. The transcript records its own cwd, so read that.
project_list() {
  python3 - "$HOME/.claude/projects" <<'PROJ'
import json, os, sys
root = sys.argv[1]
rows = []
for d in os.listdir(root):
    p = os.path.join(root, d)
    if not os.path.isdir(p):
        continue
    files = [os.path.join(p, f) for f in os.listdir(p) if f.endswith(".jsonl")]
    if not files:
        continue
    newest = max(files, key=os.path.getmtime)
    cwd = ""
    try:
        with open(newest) as fh:
            for i, line in enumerate(fh):
                if i > 50:
                    break
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                if j.get("cwd"):
                    cwd = j["cwd"]
                    break
    except OSError:
        continue
    # skip subagent scratch dirs and projects whose folder is gone — resuming
    # into a path that no longer exists just strands you somewhere useless
    if not cwd or cwd.startswith(("/private/tmp", "/tmp", "/var/folders")):
        continue
    if not os.path.isdir(cwd):
        continue
    rows.append((int(os.path.getmtime(newest)), len(files), cwd))
for mt, n, cwd in sorted(rows, reverse=True):
    print(f"{mt}\t{n}\t{cwd}")
PROJ
}

# Pick a project, then hand off to its session menu. Switching project means
# this tab adopts that folder, so PROJ_DIR/ARCHIVE_DIR move with it.
project_menu() {
  local projects n=0 ans c
  projects=$(project_list)
  [ -z "$projects" ] && { echo "  no projects with sessions"; return; }
  echo
  echo "── projects ──"
  while IFS=$'\t' read -r mt cnt cwd; do
    n=$((n+1))
    printf "  %2d) %-4s %-42s \033[2m%s session%s\033[0m\n" \
           "$n" "$(age "$mt")" "${cwd/#$HOME/~}" "$cnt" "$([ "$cnt" = 1 ] || echo s)"
    eval "R$n=\"\$cwd\""
  done <<< "$projects"
  echo
  echo "  <n>=open project  Enter=back"
  printf "> "
  read -r ans || return
  case "$ans" in
    [0-9]*)
      c=$(eval echo "\${R$ans:-}")
      [ -z "$c" ] && { echo "no project $ans"; return; }
      cd "$c" || return
      ENC_CWD="$(pwd | sed 's/[^a-zA-Z0-9]/-/g')"
      PROJ_DIR="$HOME/.claude/projects/$ENC_CWD"
      ARCHIVE_DIR="$HOME/.claude-thread/archived/$ENC_CWD"
      set_title
      main_menu
      ;;
  esac
}

main_menu() { # $1="all" to show every session (default: 15 newest)
  local sessions archived running n i total limit=15
  [ "${1:-}" = "all" ] && limit=100000
  sessions=$(list_sessions "$PROJ_DIR")
  archived=$(list_sessions "$ARCHIVE_DIR")
  running=$(state running)
  local profiles; profiles=$(state profiles)

  echo
  echo "── claude sessions: $(pwd) ──"
  n=0
  if [ -n "$sessions" ]; then
    total=$(echo "$sessions" | wc -l | tr -d ' ')
    while IFS=$'\t' read -r mt uuid prev; do
      n=$((n+1))
      [ $n -gt $limit ] && break
      local mark=" " tag
      echo "$running" | grep -q "^$uuid$" && mark="●"
      tag=$(printf '%s\n' "$profiles" | awk -F'\t' -v u="$uuid" '$1 == u {print "[" $2 "] "; exit}')
      printf "  %2d)%s%-4s %s%s  \033[2m%s\033[0m\n" "$n" "$mark" "$(age "$mt")" "$tag" "$prev" "${uuid:0:8}"
      eval "S$n=\"\$uuid\""
    done <<< "$sessions"
    [ "$total" -gt "$limit" ] && echo "  … +$((total-limit)) older ('m'=show all)"
  else
    echo "  (no active sessions)"
  fi
  [ -n "$archived" ] && echo "  archived: $(echo "$archived" | wc -l | tr -d ' ') (type 'l' to list/restore)"
  # Enter always means "continue": resume the newest session that isn't already
  # open elsewhere (falls back to new when there's nothing to continue).
  local default_i=0 j=1
  while [ $j -le $n ] && [ $j -le $limit ]; do
    local cand; cand=$(eval echo "\${S$j:-}")
    if [ -n "$cand" ] && ! echo "$running" | grep -q "^$cand$"; then
      default_i=$j; break
    fi
    j=$((j+1))
  done

  echo
  if [ "$default_i" -gt 0 ]; then
    echo "  Enter=resume #$default_i  <n>=resume  n=new  a<n>=archive  d<n>=delete  l=archived  m=all  p=projects  q=shell   ●=open elsewhere"
  else
    echo "  Enter=new  <n>=resume  a<n>=archive  d<n>=delete  l=archived  m=all  p=projects  q=shell   ●=open elsewhere"
  fi
  printf "> "
  read -r ans || exit 0

  # Enter → continue (newest free session), or new when none is free
  [ -z "$ans" ] && { [ "$default_i" -gt 0 ] && ans=$default_i || ans=n; }

  case "$ans" in
    n)       new_session ;;
    q)       exit 0 ;;
    m)       main_menu all ;;
    p)       project_menu; main_menu ;;
    l)       archive_menu; main_menu ;;
    a[0-9]*) i=${ans#a}; local u; u=$(eval echo "\${S$i:-}")
             if [ -n "$u" ]; then
               if echo "$running" | grep -q "^$u$"; then echo "session open elsewhere — close it first"
               else mkdir -p "$ARCHIVE_DIR"; mv "$PROJ_DIR/$u.jsonl" "$ARCHIVE_DIR/"; echo "archived ${u:0:8}"; fi
             fi
             main_menu ;;
    d[0-9]*) i=${ans#d}; local u; u=$(eval echo "\${S$i:-}")
             if [ -n "$u" ]; then
               printf "delete %s permanently? [y/N] " "${u:0:8}"; read -r c
               [ "$c" = "y" ] && rm "$PROJ_DIR/$u.jsonl" && echo "deleted"
             fi
             main_menu ;;
    [0-9]*)  local u; u=$(eval echo "\${S$ans:-}")
             if [ -n "$u" ]; then
               if echo "$running" | grep -q "^$u$"; then
                 printf "session open in another thread — resume anyway? [y/N] "; read -r c
                 [ "$c" != "y" ] && { main_menu; return; }
               fi
               run_claude "$u" --resume "$u"; post_exit_menu
             else echo "no session $ans"; main_menu; fi ;;
    *)       main_menu ;;
  esac
}

# claude exited → we exit too, back to the shell. Run `claude-thread` (or the
# `cld` alias) to get the picker again; exit should mean exit.
post_exit_menu() {
  set_title  # reclaim title in case claude overwrote it
  exit 0
}

archive_menu() {
  local archived n=0
  archived=$(list_sessions "$ARCHIVE_DIR")
  [ -z "$archived" ] && { echo "  no archived sessions"; return; }
  echo
  echo "── archived ──"
  while IFS=$'\t' read -r mt uuid prev; do
    n=$((n+1))
    printf "  %2d) %-4s %s  \033[2m%s\033[0m\n" "$n" "$(age "$mt")" "$prev" "${uuid:0:8}"
    eval "A$n=\"\$uuid\""
  done <<< "$archived"
  echo "  <n>=restore  Enter=back"
  printf "> "
  read -r ans || ans=""
  case "$ans" in
    [0-9]*) local u; u=$(eval echo "\${A$ans:-}")
            [ -n "$u" ] && mv "$ARCHIVE_DIR/$u.jsonl" "$PROJ_DIR/" && echo "restored ${u:0:8}" ;;
  esac
}

# ── account commands — before the Zed title probe, since they launch nothing ──
case "${1:-}" in
  profile) shift; profile_cmd "$@"; exit $? ;;
  ask)     shift; ask_main "$@"; exit $? ;;
  quota)   shift; quota_cmd "$@"; exit $? ;;
  # `cld main …` — the main account here, even in a folder mapped to a profile
  # and for a session that started on one; then carries on as plain `cld …`
  main)    shift; export CLAUDE_PROFILE=main ;;
  # `cld @<account> …` — that account here, like `cld main`. Background-agent
  # commands go straight to that account's own manager: `claude agents` only
  # sees the account it runs under.
  @*)
    pick=$(profile_pick "${1#@}") || exit 1; shift
    case "${1:-}" in
      agents|attach|logs|stop|kill|respawn|rm)
        [ "$pick" = main ] && exec env -u CLAUDE_CONFIG_DIR "$CLAUDE_BIN" "$@"
        CLAUDE_CONFIG_DIR="$PROFILES_ROOT/$pick" exec "$CLAUDE_BIN" "$@" ;;
    esac
    export CLAUDE_PROFILE="$pick" ;;
esac
# after @ so `cld @sun spawn …` queues on that account
[ "${1:-}" = spawn ] && { shift; spawn_cmd "$@"; exit $?; }

# Resolved once, before any launch path: which Zed thread this shell is. The
# nonce briefly replaces the tab title; the set_title calls below put it back.
TERMINAL_ID="$(zed_terminal_id)"

# ── sc-managed launches (super.engineering command override) ──
# sc invokes us with its own args (--session-id <new-id> for new tabs,
# --resume [<id>] for restored ones). Pass them through — PATH resolves
# `claude` back to sc's wrapper, which re-injects sc's hooks/settings —
# but record everything in state so a forgotten tab can still auto-resume.
if [ $# -gt 0 ]; then
  set_title
  # `cld new` / `cld -n` — straight into a fresh session, no picker at all.
  # Unambiguous: sc only ever passes flags starting with `--`.
  case "$1" in
    new|-n)       new_session ;;
    projects|-p)  project_menu; exit 0 ;;
  esac
  sid="" prev=""
  for a in "$@"; do
    case "$prev" in
      --resume|--session-id)
        case "$a" in
          [a-f0-9]*-*-*-*-*) sid="$a" ;;
        esac ;;
    esac
    prev="$a"
  done
  if [ -n "$sid" ]; then
    # sc knows the session — passthrough, tracked
    run_claude "$sid" "$@"
    post_exit_menu
    exit 0
  fi
  case "$*" in
    *--resume*)
      # sc forgot which session this tab was — recover from our state
      claimed=$(state claim "$(pwd)" "$PROJ_DIR" "$TERMINAL_ID")
      if [ -n "$claimed" ]; then
        echo "sc lost this tab's session — recovering from state"
        countdown_choice "${claimed:0:8}"; choice=$?
        if [ $choice -ne 0 ]; then
          state end "$claimed" >/dev/null
          [ $choice -eq 2 ] && new_session
          main_menu; exit 0
        fi
        run_claude "$claimed" --resume "$claimed"
        post_exit_menu
        exit 0
      fi ;;
  esac
  # nothing to recover — run what sc asked (plus the fixed flags). Which account:
  # claude's own pickers can't be told, so a bare --resume opens ours instead
  # (it routes each session to its account); --continue takes the newest
  # session here and its recorded account; anything else, the folder's.
  case " $* " in
    *" --resume "*|*" -r "*) main_menu; exit 0 ;;
    *" --continue "*|*" -c "*)
      prof=$(resolve_profile "$(list_sessions "$PROJ_DIR" | head -1 | cut -f2)") ;;
    *) prof=$(resolve_profile) ;;
  esac
  claude_cmd "$prof" "$@"
  exit $?
fi

# ── entry ──
set_title
# A thread Zed restored comes back with its terminal_id, so we know what it held
# before the quit — offer that without launching anything. A thread you just
# opened yourself has no binding and falls through to the eager path below,
# because asking for a terminal is asking to work in it.
parked=$(state bound "$TERMINAL_ID" "$PROJ_DIR")
[ -n "$parked" ] && lazy_resume "$parked"

# a new tab here is what a queued `cld spawn` waits for
spawned=$(spawn_take)
[ -n "$spawned" ] && { spawn_run "$spawned"; exit 0; }

claimed=$(state claim "$(pwd)" "$PROJ_DIR" "$TERMINAL_ID")
if [ -n "$claimed" ]; then
  countdown_choice "${claimed:0:8}"; choice=$?
  case $choice in
    0) run_claude "$claimed" --resume "$claimed"; post_exit_menu ;;
    2) state end "$claimed" >/dev/null; new_session ;;
    *) state end "$claimed" >/dev/null; main_menu ;;
  esac
elif [ -z "$(list_sessions "$PROJ_DIR")" ] && [ -z "$(list_sessions "$ARCHIVE_DIR")" ]; then
  # nothing to pick from — go straight into a fresh session
  new_session
else
  main_menu
fi
