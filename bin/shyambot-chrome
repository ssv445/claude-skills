#!/usr/bin/env bash
# shyambot-chrome — open the shared agent Chrome profile (see `agent-chrome`).
#
# Same profile every agent drives, so a login you do here is a login they get.
# Idempotent: if it's already running this just focuses/opens, never a 2nd copy.
#
#   shyambot-chrome                  launch (or focus) the profile
#   shyambot-chrome <url>            launch and open <url>
#   shyambot-chrome --port           print the CDP port (for scripts)
#   shyambot-chrome --stop           quit it
set -euo pipefail

PROFILE=shyambot

case "${1:-}" in
  --port) exec agent-chrome port "$PROFILE" ;;
  --stop) exec agent-chrome stop "$PROFILE" ;;
esac

agent-chrome start "$PROFILE" >/dev/null
port=$(agent-chrome port "$PROFILE")

# Focus BEFORE navigating. The other order looks fine but isn't: `open -b` can raise
# a different window, so the tab agent-browser just navigated stops being the active
# target and the caller's next `eval` reads the wrong page.
open -b com.shyam.shyambot-chrome 2>/dev/null || true

if [[ -n "${1:-}" ]]; then
  agent-browser --cdp "$port" open "$1" >/dev/null 2>&1 || true
fi

echo "shyambot-chrome ready — CDP 127.0.0.1:$port"
