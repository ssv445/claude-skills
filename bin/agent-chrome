#!/usr/bin/env bash
# agent-chrome — run multiple independent Chrome profiles for AI agents.
# Each profile gets its own user-data-dir (persistent logins) and its own
# CDP port, so agents can drive them concurrently without touching your
# daily Chrome and without the "Allow remote debugging?" consent dialog
# (that dialog only appears when attaching to an already-running Chrome;
# launching with flags enables CDP from the start).
#
# Usage:
#   agent-chrome start <name>    launch profile (creates on first use)
#   agent-chrome stop <name>     quit that profile's Chrome
#   agent-chrome list            all profiles: port + running state
#   agent-chrome port <name>     print CDP port (for scripts)
#   agent-chrome url <name>      print ws:// CDP endpoint (for playwright/puppeteer)
#   agent-chrome profiles        list daily-Chrome profiles (read-only; these can
#                                NOT be CDP-driven directly — see 'seed' pattern)
set -euo pipefail

CHROME_APP="/Applications/Google Chrome.app"
CHROME="$CHROME_APP/Contents/MacOS/Google Chrome"
ROOT="$HOME/.agent-browsers"
PORTS="$ROOT/ports"        # registry: "<name> <port>" per line
BASE_PORT=9301

mkdir -p "$ROOT"
touch "$PORTS"

port_of() { awk -v n="$1" '$1==n{print $2}' "$PORTS"; }

# Assign a stable port per profile: reuse registered one, else next free.
assign_port() {
  local name="$1" p
  p=$(port_of "$name")
  if [[ -z "$p" ]]; then
    p=$BASE_PORT
    while grep -q " $p$" "$PORTS"; do p=$((p+1)); done
    echo "$name $p" >> "$PORTS"
  fi
  echo "$p"
}

running() { curl -sf "http://127.0.0.1:$1/json/version" >/dev/null 2>&1; }

cmd="${1:-list}"; name="${2:-}"

case "$cmd" in
  start)
    [[ -n "$name" ]] || { echo "usage: agent-chrome start <name>" >&2; exit 1; }
    port=$(assign_port "$name")
    if running "$port"; then echo "'$name' already running on port $port"; exit 0; fi
    mkdir -p "$ROOT/$name"
    # Distinct window color per profile so instances are tellable apart when
    # switching (Cmd+Tab / Mission Control). Color is stable: derived from the
    # profile's registered port. Theme installs into the profile and persists.
    colors=("217,48,37" "26,115,232" "24,128,56" "227,116,0" "154,60,220" "0,131,143" "194,24,91" "93,64,55")
    color="${colors[$(( (port - BASE_PORT) % ${#colors[@]} ))]}"
    # Cmd+Tab groups by bundle identity, not argv[0]. If a cloned bundle exists at
    # ~/Applications/<name>-chrome.app (own CFBundleIdentifier + CFBundleName), use
    # it so the profile is a SEPARATE app in the switcher. See 'clone' subcommand.
    bin="$CHROME"
    alt="$HOME/Applications/$name-chrome.app/Contents/MacOS/Google Chrome"
    [[ -x "$alt" ]] && bin="$alt"
    # exec -a renames argv[0] so `ps`/`pgrep`/Activity Monitor show "<name>-chrome"
    # instead of a wall of identical "Google Chrome" rows. Only the browser
    # process renames; its helpers still report as "Google Chrome Helper".
    ( exec -a "$name-chrome" "$bin" \
        --user-data-dir="$ROOT/$name" \
        --remote-debugging-port="$port" \
        --install-autogenerated-theme="$color" \
        --restore-last-session \
        --no-first-run --no-default-browser-check \
        >/dev/null 2>&1 ) &
    disown
    # Wait for CDP to come up so callers can connect immediately.
    for _ in $(seq 1 50); do running "$port" && break; sleep 0.2; done
    echo "'$name' running — CDP http://127.0.0.1:$port"
    ;;
  stop)
    [[ -n "$name" ]] || { echo "usage: agent-chrome stop <name>" >&2; exit 1; }
    port=$(port_of "$name")
    [[ -n "$port" ]] || { echo "unknown profile '$name'" >&2; exit 1; }
    # Kill only the Chrome owning this profile dir — never other instances.
    # Helpers (renderer/gpu/utility) inherit --user-data-dir, so a bare pgrep|head -1
    # usually returns a HELPER and killing it leaves the browser running. The browser
    # is the only one of them WITHOUT a --type= flag.
    pid=""
    for p in $(pgrep -f -- "--user-data-dir=$ROOT/$name" 2>/dev/null || true); do
      ps -o args= -p "$p" 2>/dev/null | grep -q -- "--type=" || { pid="$p"; break; }
    done
    if [[ -n "$pid" ]]; then
      kill "$pid"
      for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
      # Quitting the browser reaps its helpers; only escalate if something lingers.
      sleep 0.5
      pkill -f -- "--user-data-dir=$ROOT/$name" 2>/dev/null || true
      echo "'$name' stopped"
    else
      echo "'$name' not running"
    fi
    ;;
  list)
    printf "%-16s %-6s %s\n" "PROFILE" "PORT" "STATE"
    while read -r n p; do
      [[ -n "$n" ]] || continue
      if running "$p"; then s="running"; else s="stopped"; fi
      printf "%-16s %-6s %s\n" "$n" "$p" "$s"
    done < "$PORTS"
    ;;
  port)
    [[ -n "$name" ]] || { echo "usage: agent-chrome port <name>" >&2; exit 1; }
    p=$(port_of "$name"); [[ -n "$p" ]] || { echo "unknown profile '$name'" >&2; exit 1; }
    echo "$p"
    ;;
  url)
    [[ -n "$name" ]] || { echo "usage: agent-chrome url <name>" >&2; exit 1; }
    p=$(port_of "$name"); [[ -n "$p" ]] || { echo "unknown profile '$name'" >&2; exit 1; }
    curl -sf "http://127.0.0.1:$p/json/version" | sed -n 's/.*"webSocketDebuggerUrl": *"\([^"]*\)".*/\1/p'
    ;;
  profiles)
    python3 - <<'PY'
import json, os
path = os.path.expanduser('~/Library/Application Support/Google/Chrome/Local State')
cache = json.load(open(path))['profile']['info_cache']
print(f"{'DIR':<12} {'NAME':<22} ACCOUNT")
for dir_, info in sorted(cache.items()):
    print(f"{dir_:<12} {info.get('name','?'):<22} {info.get('user_name','')}")
PY
    ;;
  clone)
    # Build ~/Applications/<name>-chrome.app: an APFS clone of Chrome with its own
    # bundle identity, so the profile gets its own Cmd+Tab entry and name.
    # Costs ~no disk (cp -c clones blocks). Re-run after Chrome auto-updates —
    # the clone does NOT update itself.
    [[ -n "$name" ]] || { echo "usage: agent-chrome clone <name>" >&2; exit 1; }
    dest="$HOME/Applications/$name-chrome.app"
    title="$(tr '[:lower:]' '[:upper:]' <<<"${name:0:1}")${name:1} Chrome"
    running "$(port_of "$name" || echo 0)" && { echo "stop '$name' first" >&2; exit 1; }
    mkdir -p "$HOME/Applications"
    rm -rf "$dest"
    cp -Rc "$CHROME_APP" "$dest"
    pl="$dest/Contents/Info.plist"
    /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier com.shyam.$name-chrome" "$pl"
    /usr/libexec/PlistBuddy -c "Set :CFBundleName $title" "$pl"
    /usr/libexec/PlistBuddy -c "Add :CFBundleDisplayName string $title" "$pl" 2>/dev/null \
      || /usr/libexec/PlistBuddy -c "Set :CFBundleDisplayName $title" "$pl"
    # Re-apply the custom icon, else a re-clone after a Chrome update silently
    # reverts to the stock Chrome mark.
    # CFBundleIconName wins over CFBundleIconFile on modern macOS: it resolves
    # "AppIcon" out of the compiled Assets.car, so app.icns is never consulted and
    # the clone keeps showing the stock Chrome mark however good our icns is.
    # Dropping the key is what makes macOS fall back to CFBundleIconFile=app.icns.
    icon="$ROOT/icons/$name.icns"
    if [[ -f "$icon" ]]; then
      cp "$icon" "$dest/Contents/Resources/app.icns"
      /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$pl" 2>/dev/null || true
    fi
    # Editing Info.plist invalidates the signature; macOS then refuses to launch.
    # xattr -cr first, else codesign rejects "resource fork ... detritus".
    xattr -cr "$dest"
    codesign --force --sign - "$dest"
    codesign --verify "$dest" && echo "cloned '$title' → $dest"
    ;;
  *)
    echo "usage: agent-chrome {start|stop|list|port|url|profiles|clone} [name]" >&2; exit 1
    ;;
esac
