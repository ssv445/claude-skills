#!/usr/bin/env bash
# bin/approve <pr>          owner validated the evidence → adds "approved" to the PR
# bin/approve --spec <issue> owner approved a blast-radius spec → adds "spec-approved"
# Owner only, at a real terminal: agents share the owner's gh login, so the TTY and the
# typed confirmation are what separate a human approval from an agent one. Agents are
# also blocked from running this by the .claude guard hook.
. "$(git rev-parse --show-toplevel)/.standards/lib/common.sh"

[ -t 0 ] && [ -t 1 ] || { red "bin/approve runs only at the owner's terminal"; exit 1; }

if [ "$1" = "--spec" ]; then kind=issue; n="$2"; label=spec-approved
else kind=pr; n="$1"; label=approved
fi
[ -n "$n" ] || { echo "usage: bin/approve <pr> | bin/approve --spec <issue>"; exit 1; }

gh "$kind" view "$n" || exit 1
[ "$kind" = issue ] && ls docs/work/"$n"-*/spec.md 2>/dev/null
printf '\nType the number %s to approve %s #%s: ' "$n" "$kind" "$n"
read -r typed
[ "$typed" = "$n" ] || { red "not approved: expected the number $n, got '$typed'"; exit 1; }
gh label create "$label" --color 0E8A16 --description "Owner approval (repo standards)" >/dev/null 2>&1
# Re-adding a label that is already present records no new "labeled" event, and bin/ship
# dates the approval by that event — so it would say "re-approve" forever. Remove the
# label first so the add below stamps a fresh event.
labels="$(gh "$kind" view "$n" --json labels -q '.labels[].name')" \
  || { red "could not read labels on $kind #$n — nothing changed; re-run"; exit 1; }
removed=""
if printf '%s\n' "$labels" | grep -qx "$label"; then
  gh "$kind" edit "$n" --remove-label "$label" >/dev/null || exit 1
  removed=1
fi
if gh "$kind" edit "$n" --add-label "$label"; then green "$label added to $kind #$n"
else
  [ -z "$removed" ] || red "label removed; re-run bin/approve $([ "$kind" = issue ] && printf -- '--spec ')$n"
  exit 1
fi
