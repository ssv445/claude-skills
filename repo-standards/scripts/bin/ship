#!/usr/bin/env bash
# bin/ship [pr]: the only merge path. Runs the pre-merge gates, then merges (MERGE_MODE in
# config.sh: squash by default, merge or rebase).
# Approval: the owner's `approved` label, or — when every gate passes and
# .standards/checks/agent-approval.sh agrees — the agent's own.
. "$(git rev-parse --show-toplevel)/.standards/lib/common.sh"

git fetch -q origin "$BASE_BRANCH"

# base_copy <path>: the base branch's copy of <path> in a temp file when it exists there
# and differs from the working copy; prints nothing otherwise. A branch must not rewrite
# the rules that judge it, so those rules run from the base.
base_copy() {
  local tmp
  git cat-file -e "origin/$BASE_BRANCH:$1" 2>/dev/null || return 0
  tmp="$(mktemp "${TMPDIR:-/tmp}/standards-base.XXXXXX")"
  git show "origin/$BASE_BRANCH:$1" > "$tmp"
  if cmp -s "$tmp" "$1"; then safe_rm "$tmp"; return 0; fi
  chmod +x "$tmp"
  printf '%s\n' "$tmp"
}
# This stops honest drift, not a hostile branch: the branch's own bin/ship, common.sh and
# config.sh run first and could drop this step. Like guard.sh, a speed bump, not a
# security boundary; real enforcement needs a server-side required check / branch protection.
if [ -z "$STANDARDS_SHIP_FROM_BASE" ]; then
  base_ship="$(base_copy bin/ship)"
  if [ -n "$base_ship" ]; then
    info "running origin/$BASE_BRANCH's bin/ship (this branch changes it)"
    STANDARDS_SHIP_FROM_BASE="$base_ship" exec bash "$base_ship" "$@"
  fi
fi
check=""; owner_log="$(mktemp)"; changed_gates=""; entries=""; record_fail=""
# The re-exec'd run is itself a temp copy ($0); remove it with the others — but only when
# $0 is exactly the temp file base_copy made, never a script inside the repo. safe_rm comes
# from the working copy's common.sh, which the base copy sources too; it refuses an empty
# name, so each variable is tested first ($check stays empty when agent-approval.sh is the
# working copy's).
cleanup() {
  [ -z "$check" ] || safe_rm "$check"
  [ -z "$owner_log" ] || safe_rm "$owner_log"
  case "$0" in "$ROOT"/*|bin/*|./*) return ;; esac
  case "$(basename "$0")" in standards-base.*) ;; *) return ;; esac
  [ "$0" = "$STANDARDS_SHIP_FROM_BASE" ] && safe_rm "$0"
}
trap cleanup EXIT

# Checked before any gate runs, so a typo never fails only at the last step.
case "${MERGE_MODE:=squash}" in
  squash|merge|rebase) ;;
  *) red "FAIL ship: MERGE_MODE=\"$MERGE_MODE\" — use squash, merge or rebase in .standards/config.sh"; exit 1 ;;
esac
pr="${1:-$(gh pr view --json number -q .number 2>/dev/null)}"
[ -n "$pr" ] || { red "FAIL ship: no PR for this branch (usage: bin/ship <pr>)"; exit 1; }
json="$(gh pr view "$pr" --json headRefName,headRefOid,labels,closingIssuesReferences)" || exit 1
head_ref="$(printf '%s' "$json" | jq -r .headRefName)"
head_oid="$(printf '%s' "$json" | jq -r .headRefOid)"

echo "repo-standards ship: PR #$pr ($head_ref)"
[ "$(git rev-parse --abbrev-ref HEAD)" = "$head_ref" ] || { red "FAIL ship: check out $head_ref first"; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { red "FAIL ship: uncommitted changes"; exit 1; }
[ "$(git rev-parse HEAD)" = "$head_oid" ] || { red "FAIL ship: local HEAD differs from the PR head — push (through the pre-push gate) first"; exit 1; }
git merge-base --is-ancestor "origin/$BASE_BRANCH" HEAD || { red "FAIL ship: branch is behind origin/$BASE_BRANCH — rebase and push"; exit 1; }
green "PASS branch current and pushed"

fail=0
"$ROOT/.standards/checks/decision-log.sh" "Spec gate" "Plan gate" "Pre-merge gate" || fail=1

repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
# label_check <issue-or-pr number> <label>: stdout = time the label was last added;
# messages go to stderr so callers can capture the time.
label_check() {
  local ev
  # --slurp wraps all pages in one array, so "last" is the last event overall — gh's -q
  # would run the filter per page (30 events each) and miss or misattribute the label.
  ev="$(gh api "repos/$repo/issues/$1/events" --paginate --slurp \
        | jq -r "[.[][] | select(.event==\"labeled\" and .label.name==\"$2\")] | last | \"\(.actor.login) \(.created_at)\"")"
  gh "$3" view "$1" --json labels -q '.labels[].name' | grep -qx "$2" || ev=""
  set -- "$1" "$2" "$3" $ev
  if [ -z "$4" ] || [ "$4" = "null" ]; then red "  miss #$1 has no '$2' label" >&2; return 1; fi
  if [ -n "$OWNER" ] && [ "$4" != "$OWNER" ]; then red "  miss '$2' on #$1 was added by $4, not $OWNER" >&2; return 1; fi
  info "ok   '$2' on #$1 by $4 at $5" >&2
  printf '%s\n' "$5"
}

# APPROVER comes from the base's config.sh (see approver_mode), never this branch's.
mode="$(approver_mode)"
info "mode APPROVER=$mode (from the base's config.sh)"
spec="$(issue_dir)/spec.md"
blast=""
if [ -f "$spec" ] && grep -qiE "$(owner_flag_re approval)" "$spec"; then
  blast=1
  if [ "$mode" = agent ]; then info "ok   blast-radius spec: spec gate PASS stands in for spec-approved (APPROVER=agent)"
  else label_check "$(issue_number)" spec-approved issue >/dev/null || fail=1
  fi
fi

# By change class: the app's e2e and perf skip on a site or docs branch, the site's e2e runs only
# when the site changed. With no classes configured the class is "all" and everything runs.
run_part e2e app "$E2E_CMD" || fail=1
run_part site-e2e site-change "$SITE_E2E_CMD" || fail=1
run_part perf app "$PERF_CMD" || fail=1
# The baseline must follow coverage up: pre-push only stops it falling.
"$ROOT/.standards/checks/coverage-baseline.sh" --ratchet || fail=1

[ $fail -eq 0 ] || { red "ship BLOCKED"; exit 1; }

# Approval. The owner's label must postdate the head commit: new commits need re-approval.
# Without it, the agent approves when agent-approval.sh (the base's copy, if this branch
# changes it) finds nothing that needs the owner.
# The owner-label misses are printed only if the agent cannot approve either.
check="$(base_copy .standards/checks/agent-approval.sh)"
checker="${check:-$ROOT/.standards/checks/agent-approval.sh}"
approval=""
if approved_at="$(label_check "$pr" approved pr 2>"$owner_log")"; then
  cat "$owner_log"
  commit_at="$(TZ=UTC git log -1 --date=format-local:%Y-%m-%dT%H:%M:%SZ --format=%cd HEAD)"
  if [[ "$approved_at" < "$commit_at" ]]; then red "  miss approval ($approved_at) predates head commit ($commit_at) — re-approve" > "$owner_log"
  else approval=owner; fi
fi
if [ -z "$approval" ]; then
  if out="$("$checker" 2>&1)"; then
    printf '%s\n' "$out"
    approval=agent
  else
    cat "$owner_log"
    printf '%s\n' "$out"
    red "ship BLOCKED: fix the misses above, then re-run; an owner-review flag the owner has answered, close as answered in decisions.md; for no base, a removed owner-approval flag or (APPROVER=owner) gate files, ask the owner to run bin/approve $pr"
    exit 1
  fi
fi

# Gate files the branch changes, whoever approved: the owner finds every rule change under
# the rules-changed label, owner-approved ones too. Same detection as agent-approval.sh (the
# check that ran). Read now — the merge deletes the branch. No list, no merge: a gate change
# must never ship unrecorded.
changed_gates="$("$checker" --gate-files)" || { red "FAIL ship: could not list the gate files this branch changes"; exit 1; }
[ -z "$changed_gates" ] || entries="$(git diff -U0 --no-renames "$(base_commit)" HEAD -- docs/rule-changes.md | sed -n 's/^+\(- [0-9]\{4\}-.*\)/\1/p')"

# --match-head-commit: refuse if the PR moved after these gates ran.
gh pr merge "$pr" "--$MERGE_MODE" --delete-branch --match-head-commit "$head_oid" || { red "FAIL ship: merge refused"; exit 1; }
green "shipped #$pr ($approval-approved)"
# The record is posted only once the merge happened, so it never claims an unmerged PR.
# A gate change, whoever approved: the owner reads it in docs/rule-changes.md (merged with
# it, when a line was added) and finds the PRs under the rules-changed label. Agents post as
# the owner, so a mention would notify nobody. A missing record fails the run, never lost
# silently.
notice=""
if [ -n "$changed_gates" ]; then
  if [ -n "$entries" ]; then logged="Logged in \`docs/rule-changes.md\`:
$entries"
  else logged="No line was added to \`docs/rule-changes.md\`."; fi
  notice="

**The rules agents work under changed in this PR** (\`$changed_gates\`). $logged"
  gh label create rules-changed --color D93F0B --description "Changed the rules agents work under (repo standards)" >/dev/null 2>&1
  gh pr edit "$pr" --add-label rules-changed >/dev/null \
    || { red "FAIL ship: merged, but the rules-changed label failed — run: gh pr edit $pr --add-label rules-changed"; record_fail=1; }
fi
# Owner-approved: the owner already knows why; a comment only when the rules changed.
if [ "$approval" = owner ] && [ -n "$changed_gates" ]; then
  gh pr comment "$pr" --body "Approved by the owner (\`approved\` label) and merged through \`bin/ship\`.

- Gate files changed (\`$changed_gates\`), approved by the owner's \`approved\` label

Head: $head_oid$notice" || { red "  warn merged, but the rule-change comment failed — post it by hand"; record_fail=1; }
fi
if [ "$approval" = agent ]; then
  # The gate list comes from the check that ran, so the record cannot drift from it.
  gates="$(sed -n 's/^GATE_FILES="\(.*\)"$/\1/p' "$checker")"
  if [ -z "$blast" ]; then spec_line="Spec not marked \`owner-approval: required\`"
  elif [ "$mode" = agent ]; then spec_line="Blast-radius spec: spec gate PASS stands in for \`spec-approved\` (APPROVER=agent)"
  else spec_line="Blast-radius spec: owner's \`spec-approved\` label present"; fi
  # Agent-approved gate files passed agent-approval.sh, so APPROVER=agent and the
  # gate-change review passed.
  if [ -n "$changed_gates" ]; then
    gate_line="Gate files changed, approved under APPROVER=agent (\`$changed_gates\`): the gate-change review passed — no check weakened, skipped or bypassed (both reviewers, or the arbiter on a split)"
  else
    gate_line="No gate file changed (\`$gates\`)"
  fi
  gh pr comment "$pr" --body "Approved by the agent through \`bin/ship\`: every pre-merge gate passed and \`.standards/checks/agent-approval.sh\` found nothing that needs the owner.

Mode: APPROVER=$mode (from the base branch's \`.standards/config.sh\`)

- Pre-merge gate \`Verdict: PASS\`: both reviewers PASS, or one PASS and the arbiter PASS; no duplicate gate lines
- \`Reviewed:\` commit covers the head — every file the branch changes matches it, decisions.md aside
- No open \`owner-review: required\` line in decisions.md, every removed one closed as answered, and no \`owner-approval: required\` removed
- $gate_line
- $spec_line
- Spec gate and plan gate passed (or not needed on a docs-only branch), e2e and perf passed

Head: $head_oid$notice" || { red "  warn merged, but the approval comment failed — post it by hand"; [ -z "$changed_gates" ] || record_fail=1; }
fi
[ -z "$record_fail" ] || exit 1
